  dialogueName: Story Greg Join Text
  dialogue:
  - speaker: {fileID: 11400000, guid: 21e4f9bb85bf3d44ba4487bc9d247d0a, type: 2}
    portrait: 0
    speed: 20
    lineBreakPause: 0
    text: Hmm who are you?
  - speaker: {fileID: 11400000, guid: 6aa94331ea73f894aac08a9c616e760a, type: 2}
    portrait: 0
    speed: 20
    lineBreakPause: 0.5
    text: 'Me?

      &p3To be honest I am not sure.'
  - speaker: {fileID: 11400000, guid: 21e4f9bb85bf3d44ba4487bc9d247d0a, type: 2}
    portrait: 0
    speed: 20
    lineBreakPause: 0.5
    text: 'Looks like we have that in common.

      Do you want to join me?

      We
      can try to get out of here.'
  - speaker: {fileID: 11400000, guid: 6aa94331ea73f894aac08a9c616e760a, type: 2}
    portrait: 0
    speed: 20
    lineBreakPause: 0.5
    text: 'I don''t think I have a choice.

      Lead the way, I will accompany
      you.'
  - speaker: {fileID: 11400000, guid: 1f3ab7ea342cb0644b26990907ffea4c, type: 2}
    portrait: 0
    speed: 10
    lineBreakPause: 0
    text: Greg joins the party!
  onComplete:
    m_PersistentCalls:
      m_Calls: []
