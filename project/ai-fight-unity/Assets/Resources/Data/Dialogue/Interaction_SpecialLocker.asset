  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e100a2eca9f16144b89bbd4c2d941a96, type: 3}
  m_Name: Interaction_SpecialLocker
  m_EditorClassIdentifier: 
  dialogueName: Special Locker Flavor Text
  dialogue:
  - speaker: {fileID: 11400000, guid: 1f3ab7ea342cb0644b26990907ffea4c, type: 2}
    portrait: 0
    speed: 20
    lineBreakPause: 1
    text: This locker is locked shut and won't--
  - speaker: {fileID: 11400000, guid: 1f3ab7ea342cb0644b26990907ffea4c, type: 2}
    portrait: 0
    speed: 20
    lineBreakPause: 0.5
    text: 'Nevermind.

      It opened after all.'
  - speaker: {fileID: 11400000, guid: 1f3ab7ea342cb0644b26990907ffea4c, type: 2}
    portrait: 0
    speed: 20
    lineBreakPause: 0.5
    text: 'You find a picture of a particularly big\nlooking bunny from inside it.

      You
      close the locker carefully.'
  onComplete:
    m_PersistentCalls:
      m_Calls: []
