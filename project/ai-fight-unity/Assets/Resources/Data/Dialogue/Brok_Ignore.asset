  m_Script: {fileID: 11500000, guid: e100a2eca9f16144b89bbd4c2d941a96, type: 3}
  m_Name: Brok_Ignore
  m_EditorClassIdentifier: 
  dialogueName: Brok Ignore
  dialogue:
  - speaker: {fileID: 11400000, guid: 21e4f9bb85bf3d44ba4487bc9d247d0a, type: 2}
    portrait: 0
    speed: 20
    lineBreakPause: 0.5
    text: 'Hello?

      Who are you?'
  - speaker: {fileID: 11400000, guid: 02ebafa8ff5d34b4fa8244397aeb372e, type: 2}
    portrait: 1
    speed: 20
    lineBreakPause: 0.5
    text: '&p1Brok.

      &p1Super advanced AI powered computer.'
  - speaker: {fileID: 11400000, guid: 21e4f9bb85bf3d44ba4487bc9d247d0a, type: 2}
    portrait: 4
    speed: 20
    lineBreakPause: 0
    text: Oh okay.
  - speaker: {fileID: 11400000, guid: 6aa94331ea73f894aac08a9c616e760a, type: 2}
    portrait: 4
    speed: 20
    lineBreakPause: 0
    text: Never heard of that guy.
  - speaker: {fileID: 11400000, guid: 02ebafa8ff5d34b4fa8244397aeb372e, type: 2}
    portrait: 2
    speed: 20
    lineBreakPause: 0.5
    text: 'Obviously YOU people would not know.

      Now leave me.

      I have
      important matters to attend to.'
  onComplete:
    m_PersistentCalls:
      m_Calls: []
